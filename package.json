{
  "name": "pay-it-sideways",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite --configLoader runner",
    "dev:api": "wrangler dev --port 8787",
    "db:migrate:local": "wrangler d1 migrations apply pay-it-sideways --local",
    "db:migrate:remote": "wrangler d1 migrations apply pay-it-sideways --remote",
    "build": "vue-tsc -b && vite build --configLoader runner",
    "typecheck": "vue-tsc -b --pretty false",
    "typecheck:worker": "tsc -p tsconfig.worker.json --noEmit",
    "test": "vitest run --configLoader runner",
    "test:unit": "vitest run --configLoader runner --project unit",
    "test:worker": "vitest run --configLoader runner --project worker",
    "preview": "vite preview --configLoader runner --host 0.0.0.0",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@nimiq/core": "^2.21.0",
    "@nimiq/mini-app-sdk": "0.1.0",
    "vue": "3.5.21",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.1.2",
    "@cloudflare/workers-types": "^5.20260901.1",
    "@msw/cloudflare": "^0.0.1",
    "@vitejs/plugin-vue": "6.0.1",
    "msw": "^2.15.0",
    "typescript": "5.9.2",
    "vite": "7.3.6",
    "vitest": "^4.1.11",
    "vue-tsc": "3.0.6",
    "wrangler": "^4.127.1"
  }
}
